# ==========================================
# School Website & Admin Configuration
# ==========================================

# 1. Admin Authentication Secrets
# Set a strong JWT secret for session verification (min 32 characters)
JWT_SECRET=super_secret_school_admin_jwt_key_2026_xyz987654321

# Default Master Admin Credentials (used for initial login or if no database admin yet)
ADMIN_DEFAULT_EMAIL=admin@school.edu
ADMIN_DEFAULT_PASSWORD=Admin@12345

# 2. Supabase Free Tier Configuration (Optional for local test, Required for Vercel production)
# Get these free from https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=school-media

# 3. School Details
NEXT_PUBLIC_SCHOOL_NAME="Apex International Academy"
NEXT_PUBLIC_SCHOOL_TAGLINE="Excellence in Education up to Senior Secondary (+2)"
NEXT_PUBLIC_SCHOOL_PHONE="+91 98765 43210"
NEXT_PUBLIC_SCHOOL_EMAIL="contact@apexacademy.edu.in"
NEXT_PUBLIC_SCHOOL_ADDRESS="124 Knowledge Boulevard, Institutional Area, New Delhi - 110001"
NEXT_PUBLIC_SCHOOL_AFFILIATION="Affiliated to CBSE, New Delhi (Affiliation No: 2130000)"
